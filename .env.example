# No poner claves reales en este archivo. El sitio estático no recibe variables.
OPENAI_API_KEY=
# Correo real que el operador autoriza a enviar solamente a SEC EDGAR.
# Opcional para el resto de las fuentes. Configurar como secreto, no en el catálogo.
RADAR9_SEC_CONTACT=
RADAR_MODEL_STANDARD=gpt-5.4-mini
RADAR_MODEL_DEEP=gpt-5.4
RADAR_MAX_ARTICLES=4
RADAR_DAILY_USD=0.75

# Para un modelo no incluido en config/prices.json, definir ambas tarifas del
# perfil correspondiente (USD por millón de tokens, endpoint estándar).
# RADAR_STANDARD_INPUT_USD_M=
# RADAR_STANDARD_OUTPUT_USD_M=
# RADAR_DEEP_INPUT_USD_M=
# RADAR_DEEP_OUTPUT_USD_M=
